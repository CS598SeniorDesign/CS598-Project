# QuestLog production/staging settings. See docs/DEPLOYMENT.md.
#
# On the server: copy to /opt/questlog/.env, fill in every <...> value, then `chmod 600 .env`.
# Never commit the filled-in file. Generate random secrets with:  openssl rand -base64 48 | tr -d '\n/+='

# --- Domain and images ------------------------------------------------------------------------------------------------
# The public hostname (DNS A record pointing at this server). Caddy gets its HTTPS certificate for it.
APP_DOMAIN=<questlog.example.com>
# Let's Encrypt sends certificate expiry warnings here.
ACME_EMAIL=<team-email@example.com>
# Lowercase GitHub organization/user name in the image paths.
BACKEND_IMAGE=ghcr.io/<github-owner-lowercase>/questlog-backend
FRONTEND_IMAGE=ghcr.io/<github-owner-lowercase>/questlog-frontend

# --- Django -----------------------------------------------------------------------------------------------------------
DJANGO_SECRET_KEY=<random 50+ characters>
DEBUG=False
# The admin is off in production. If you turn it on, reach it only through an SSH tunnel; Caddy blocks /admin/.
ADMIN_ENABLED=False
# "backend" lets the containers reach Django by service name (health checks, Next.js rewrites).
ALLOWED_HOSTS=<questlog.example.com>,backend,localhost
CSRF_TRUSTED_ORIGINS=https://<questlog.example.com>
CORS_ALLOWED_ORIGINS=https://<questlog.example.com>
FRONTEND_URL=https://<questlog.example.com>
BACKEND_URL=https://<questlog.example.com>
# Caddy already redirects HTTP to HTTPS; Django still marks cookies secure and sends HSTS.
SECURE_SSL_REDIRECT=False

# Features that are ready for users. Backend flags hide API endpoints; FRONTEND_* flags hide pages.
FEATURE_ANALYTICS=False
FEATURE_BGG_SYNC=True
FEATURE_RECOMMENDATIONS=True
FRONTEND_FEATURE_ANALYTICS=false
FRONTEND_FEATURE_MFA_SETUP=true

# BoardGameGeek XML API token (register an application on BGG).
BGG_API_TOKEN=<bgg-api-token>

# --- Database (the db container is created with these) ---------------------------------------------------------------
DATABASE_ENGINE=django.db.backends.postgresql
DATABASE_HOST=db
DATABASE_PORT=5432
DATABASE_NAME=questlog
DATABASE_USERNAME=questlog
DATABASE_PASSWORD=<random password>

# --- Redis ------------------------------------------------------------------------------------------------------------
REDIS_PASSWORD=<random password, letters and digits only>
REDIS_CACHE_URL=redis://default:${REDIS_PASSWORD}@redis:6379/0
REDIS_SESSION_URL=redis://default:${REDIS_PASSWORD}@redis:6379/1
REDIS_CELERY_URL=redis://default:${REDIS_PASSWORD}@redis:6379/2
CELERY_TASK_ALWAYS_EAGER=False

# --- Email (required: sign-up needs email verification) --------------------------------------------------------------
# Brevo's free plan: smtp-relay.brevo.com, port 587, your Brevo login and an SMTP key.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USE_TLS=True
SMTP_USER=<brevo-smtp-login>
SMTP_PASSWORD=<brevo-smtp-key>
DEFAULT_FROM_EMAIL=QuestLog <noreply@<questlog.example.com>>

# --- Logging, monitoring, error tracking -------------------------------------------------------------------------------
LOGLEVEL=info
LOG_FORMAT=json
# Leave empty unless you run Prometheus on the server (then use a random value).
METRICS_TOKEN=
SENTRY_DSN=<from Sentry: Project Settings > Client Keys>
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.1
# The production image has no MLflow/W&B; runs are written to the logs.
RECOMMENDER_TRACKERS=log
LIBRARY_ITEM_RETENTION_DAYS=90

# --- Database backups (scripts/backup-db.sh) ---------------------------------------------------------------------------
# Any S3-compatible bucket. Oracle Cloud Object Storage (Always Free, 20 GB):
#   endpoint https://<namespace>.compat.objectstorage.<region>.oraclecloud.com, region e.g. us-ashburn-1,
#   keys from Identity > Users > your user > Customer Secret Keys.
BACKUP_S3_ENDPOINT=<https://namespace.compat.objectstorage.region.oraclecloud.com>
BACKUP_S3_REGION=<us-ashburn-1>
BACKUP_S3_BUCKET=<questlog-backups>
BACKUP_S3_ACCESS_KEY_ID=<access key>
BACKUP_S3_SECRET_ACCESS_KEY=<secret key>
# Backups older than this are deleted from the bucket.
BACKUP_RETENTION_DAYS=30
