meta {
  name: Sync Plays
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/v1/plays/sync/
  body: none
  auth: none
}

script:post-response {
  if (res.getStatus() === 202) {
    bru.setVar("syncTaskId", res.getBody().task_id);
  }
}

tests {
  test("queues an import or explains why it cannot", function () {
    expect([202, 400]).to.include(res.getStatus());
    expect(res.getBody()).to.have.property("detail");
  });
}

docs {
  Starts importing the logged-in user's plays from BoardGameGeek in the background and returns 202 with a
  `task_id` and `status_url`. Run **Get Sync Status** to follow the import, then **List Plays** to see the
  plays. Plays already imported are updated in place, not duplicated. If an import is already queued or
  running, its task is returned instead of starting another.

  Needs the Celery worker (`docker compose up` starts it). Uses the BGG username linked to the user's
  profile (`Profile.bgg_username`); the seeded demo user has none, so this returns 400 until one is set
  (e.g. via the admin). The import also needs a valid `BGG_API_TOKEN` in the root `.env`, otherwise the
  status ends as `failed`.

  Throttled to 3 requests per minute per user (429 after that).
}
