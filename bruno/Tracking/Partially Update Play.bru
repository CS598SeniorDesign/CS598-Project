meta {
  name: Partially Update Play
  type: http
  seq: 7
}

patch {
  url: {{baseUrl}}/api/v1/plays/{{loggedPlayId}}/
  body: json
  auth: none
}

body:json {
  {
    "notes": "Sam won on the final turn"
  }
}

tests {
  test("changes only the fields that were sent", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().notes).to.equal("Sam won on the final turn");
    expect(res.getBody()).to.include({ play_date: "2026-10-02", location: "Game Café" });
  });

  test("keeps the players when none are sent", function () {
    expect(res.getBody().players).to.have.lengthOf(2);
  });
}

docs {
  Changes only the fields in the body. Leaving out `players` keeps the current players; sending `players`
  replaces the whole list.
}
