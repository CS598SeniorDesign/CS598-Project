meta {
  name: Readiness
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/ready/
  body: none
  auth: none
}

tests {
  test("database and redis are reachable", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().checks.database).to.equal("ok");
    expect(res.getBody().checks.redis).to.equal("ok");
  });
}
