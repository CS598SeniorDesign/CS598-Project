meta {
  name: Search Players
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/api/v1/players/?search=an
  body: none
  auth: none
}

docs {
  Finds registered players to add to a play session by display name (2 to 100 characters), names starting with the
  search first, at most 10. Only Public profiles and Friends profiles of your friends are returned; Private profiles and
  you never are. Send a result's `user_id` in a play's player list to add them.
}

tests {
  test("returns players as user_id and display_name only", function () {
    expect(res.getStatus()).to.equal(200);
    for (const player of res.getBody()) {
      expect(player).to.have.all.keys("user_id", "display_name");
    }
  });
}
