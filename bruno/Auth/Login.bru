meta {
  name: Login
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/_allauth/browser/v1/auth/login
  body: json
  auth: none
}

body:json {
  {
    "email": "{{userEmail}}",
    "password": "{{userPassword}}"
  }
}

script:post-response {
  // Remember the signed-in user's ID so requests can list them as a play session player.
  if (res.getStatus() === 200) {
    bru.setVar("userId", res.getBody().data.user.id);
  }
}

docs {
  Logs in with the seeded demo account. On success Django sets the `sessionid` cookie, which Bruno's
  cookie jar sends automatically on every later request.

  Also stores the user's ID in `userId` for the Play Sessions requests.
}

tests {
  test("logs in the demo user", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().data.user.email).to.equal(bru.getEnvVar("userEmail"));
  });
}
