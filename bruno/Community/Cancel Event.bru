meta {
  name: Cancel Event
  type: http
  seq: 11
}

delete {
  url: {{baseUrl}}/api/v1/events/{{plannedEventId}}/
  body: none
  auth: none
}

docs {
  Cancels the event created by **Plan Event** (run that first; this never touches seeded events). Only the host can
  change or cancel an event.
}

tests {
  test("cancels the event", function () {
    expect(res.getStatus()).to.equal(204);
  });
}
