meta {
  name: List Upcoming Events
  type: http
  seq: 10
}

get {
  url: {{baseUrl}}/api/v1/events/?days=30
  body: none
  auth: none
}

script:post-response {
  // If Plan Event has not run, remember the first listed event so RSVP to Event has one to answer.
  const events = res.getStatus() === 200 ? res.getBody() : [];
  if (!bru.getVar("eventId") && events.length) {
    bru.setVar("eventId", events[0].id);
  }
}

docs {
  Upcoming events the user can see (in their groups, or hosted by them or their friends), soonest first. `?days=` limits
  them to the next N days, `?group_id=` to one group, and `?scope=past` lists past events instead.
}

tests {
  test("lists upcoming events", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody()).to.be.an("array");
  });

  test("includes the planned event, if one was planned", function () {
    const plannedId = bru.getVar("plannedEventId");
    if (plannedId) {
      expect(res.getBody().map((event) => event.id)).to.include(plannedId);
    }
  });
}
