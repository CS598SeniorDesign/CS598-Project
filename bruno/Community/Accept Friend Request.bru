meta {
  name: Accept Friend Request
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/api/v1/friend-requests/{{incomingFriendRequestId}}/accept/
  body: none
  auth: none
}

docs {
  Accepts the request found by **List Friend Requests**; the two users become friends. Decline instead with
  `/decline/`, or withdraw a request you sent with `DELETE /api/v1/friend-requests/<id>/`. Run the seed again to get a
  new pending request for the demo login.
}

tests {
  test("accepts the request", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().status).to.equal("ACCEPTED");
  });
}
