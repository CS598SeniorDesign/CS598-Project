meta {
  name: Delete Game Group
  type: http
  seq: 12
}

delete {
  url: {{baseUrl}}/api/v1/groups/{{groupId}}/
  body: none
  auth: none
}

docs {
  Deletes the group from **Create Game Group**, with its events. Only the owner can delete a group; members leave with
  `POST /api/v1/groups/<id>/leave/`.
}

tests {
  test("deletes the group", function () {
    expect(res.getStatus()).to.equal(204);
  });
}
