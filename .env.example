# This environment file is required to be in the project root for Docker
# To develop/run locally without Docker please move your .env file into the backend directory

DJANGO_SECRET_KEY=your-super-secret-key

DEBUG=False
ADMIN_ENABLED=False

# Superuser recreated by `manage.py seed` (seeding deletes every user). Also used by `createsuperuser --noinput`.
DJANGO_SUPERUSER_EMAIL=
DJANGO_SUPERUSER_PASSWORD=

# Log level and format. Logs are JSON lines with timestamp, level, request_id and user_id; LOG_FORMAT=text is easier
# to read while debugging locally.
LOGLEVEL=info
LOG_FORMAT=json

# Bearer token for GET /metrics/ (Prometheus). Leave empty to disable the endpoint.
METRICS_TOKEN=

# Recommender experiment tracking: comma-separated list of log, mlflow, wandb.
# mlflow and wandb need `uv sync --extra monitoring`. WANDB_MODE=offline never contacts W&B.
RECOMMENDER_TRACKERS=log
# MLFLOW_TRACKING_URI=
# MLFLOW_EXPERIMENT_NAME=questlog-recommender
# WANDB_PROJECT=questlog-recommender
# WANDB_ENTITY=
# WANDB_MODE=offline

ALLOWED_HOSTS=localhost,127.0.0.1,[::1],backend

CSRF_TRUSTED_ORIGINS=http://localhost:3000

SECURE_SSL_REDIRECT=False

BACKEND_URL=http://localhost:8000

FRONTEND_URL=http://localhost:3000

BGG_API_TOKEN=another-secret-key

# Feature flags for in progress backend features
FEATURE_ANALYTICS=True
FEATURE_BGG_SYNC=True
FEATURE_RECOMMENDATIONS=True

# These are settings for the Redis Docker container
REDIS_PASSWORD=redis-password
REDIS_CACHE_URL=redis://default:${REDIS_PASSWORD}@redis:6379/0
REDIS_SESSION_URL=redis://default:${REDIS_PASSWORD}@redis:6379/1
REDIS_CELERY_URL=redis://default:${REDIS_PASSWORD}@redis:6379/2

# Celery (background and scheduled tasks). The worker, beat and Flower containers start with `docker compose up`.
# CELERY_TASK_ALWAYS_EAGER=True runs tasks inline instead, for running the backend without a worker (not for production).
CELERY_TASK_ALWAYS_EAGER=False
# Days removed library/wishlist entries are kept before being deleted for good.
LIBRARY_ITEM_RETENTION_DAYS=90

# Login for the Flower UI at http://localhost:5555, as user:password. Uncomment to require it (leave the line out
# entirely rather than empty; Flower treats an empty value as a credential).
# FLOWER_BASIC_AUTH=admin:change-me

# Settings for the postgres Docker container
# Note: If you want to develop locally without using Docker,
# change the variables to use your local database. DATABASE_HOST is the most important one to change.
DATABASE_NAME=questlog_db
DATABASE_USERNAME=django
DATABASE_PASSWORD=django-password
DATABASE_ENGINE=django.db.backends.postgresql
DATABASE_HOST=db
DATABASE_PORT=5432

# DOMAIN_URL=https://QuestLog.com

# Production email vars for verification and password-reset emails
# Leave SMTP_HOST unset for dev
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USE_TLS=True
# SMTP_USER=
# SMTP_PASSWORD=
# DEFAULT_FROM_EMAIL=QuestLog <noreply@yourdomain.com>